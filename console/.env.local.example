# The console needs the Gemini key under the name the Vercel AI SDK's Google
# provider looks for. Same value as GEMINI_API_KEY in the repo-root .env.
GOOGLE_GENERATIVE_AI_API_KEY=

# Which model backs the operator agent. Default is the one verified working for
# this project; 2.5-flash is closed to new AI Studio users.
CONSOLE_MODEL=gemini-3.5-flash

# Where the localhost bridge lives.
NEXT_PUBLIC_BRIDGE_URL=http://127.0.0.1:8080
