# Copy to .env and fill in. .env is gitignored — verify that before your first push.

# --- required ---
TELEGRAM_TOKEN=              # BotFather. Then /setprivacy -> Disable, or the bot sees nothing.
GEMINI_API_KEY=              # aistudio.google.com, no card. May start "AQ." not "AIzaSy" — both valid.
ELEVENLABS_AGENT_ID=         # Agent with authentication OFF, or plain agentId connection fails.

# --- optional, each degrades gracefully ---
EXA_API_KEY=                 # exa.ai. Absent -> discovery returns [] and OSM carries the search.
OPENROUTER_API_KEY=          # Different vendor, different outage. Last model fallback before keyless.
ELEVENLABS_API_KEY=          # Optional but worth it: lets the bridge read the agent's OWN
                             # data-collection result after the call. Without it the bridge
                             # derives the same fields from the transcript with Gemini, which
                             # works but only sees text, and says so in the chat.

# --- the booking identity the agent speaks aloud ---
BOOKER_NAME=
CALLBACK_NUMBER=+852

# --- SAFETY RAILS (brief §9) ---
# CONSENTED_NUMBERS: comma-separated allowlist. A booking for any number not on
# this list is REFUSED at the approval gate. Never cold-call a stranger's
# business with a synthetic voice.
CONSENTED_NUMBERS=+852

# DEMO_PHONE: when set, EVERY call routes here no matter which restaurant won
# the poll. The poll shows the real place; the phone that rings is yours, and
# the approval card says so out loud. Leave blank only when a real venue has
# consented and you are dialling them for real.
DEMO_PHONE=

# Escape hatch for the allowlist. Leave at 0. Set to 1 only if you understand
# that you are removing the one check that stops an uninvited call.
ALLOW_ANY_NUMBER=0
